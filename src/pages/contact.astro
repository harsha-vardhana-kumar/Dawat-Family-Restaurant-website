---
import BaseLayout from '../layouts/BaseLayout.astro';import PageHero from '../components/PageHero.astro';import LocationSection from '../components/LocationSection.astro';import Icon from '../components/Icon.astro';import {restaurant} from '../data/restaurant';
---
<BaseLayout title="Visit Dawat | Rajiv Chowk, Velpur Road, Tanuku" description="Find Dawat Family Restaurant opposite Reliance Digital at Rajiv Chowk, Velpur Road, Tanuku. Call +91 97019 19654. Open daily, 6:30 AM–10:30 PM."><PageHero eyebrow="COME ON OVER" title="Your Next" italic="Dawat Awaits." description="Right here at Rajiv Chowk, in the heart of Tanuku." compact/><LocationSection/><section class="contact-extra container"><div><p class="eyebrow">HAVE A QUESTION?</p><h2>We’re a call away.</h2><p>For dish availability or any questions before your visit, call us during opening hours.</p><a class="text-link" href={`tel:${restaurant.telephone}`}>{restaurant.phone}<Icon name="call"/></a></div><div><p class="eyebrow">STAYING IN?</p><h2>Let Dawat come to you.</h2><p>Explore online ordering through Zomato.</p><a class="text-link" href="/order-online/">Order Online<Icon/></a></div></section></BaseLayout>
