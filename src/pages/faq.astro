---
import BaseLayout from '../layouts/BaseLayout.astro';import PageHero from '../components/PageHero.astro';import CTASection from '../components/CTASection.astro';import Icon from '../components/Icon.astro';import {restaurant} from '../data/restaurant';import {signatures} from '../data/menu';
const faqs=[
 {q:'Where is Dawat Family Restaurant located?',a:`You’ll find Dawat at ${restaurant.street}, ${restaurant.city}, ${restaurant.region}. We’re ${restaurant.landmark.toLowerCase()}.`,href:'/contact/',link:'Get directions'},
 {q:'What are Dawat’s opening hours?',a:`We are open Monday to Sunday, ${restaurant.hours}. For the availability of a particular dish at your preferred time, please call us.`},
 {q:'Does Dawat provide vegetarian food?',a:'Yes. The menu includes vegetarian soups, starters, main courses, biryanis and fried rice. Use the Veg filter on our menu to see the dishes listed in vegetarian categories. For ingredients, allergies or dietary requirements, please speak with the restaurant.',href:'/menu/',link:'Explore the menu'},
 {q:'Can I order Dawat food online?',a:'Yes. Online ordering is available through Zomato. Delivery availability, current pricing and any promotions are shown on Zomato.',href:'/order-online/',link:'Order online'},
 {q:'Where can I find the Dawat menu?',a:'Our complete menu is available on this website, with dish names, supplied prices, search and category filters.',href:'/menu/',link:'View the full menu'},
 {q:'Does Dawat offer dine-in service?',a:'Yes. Dawat is a family dining restaurant in Tanuku. Visit us at Rajiv Chowk on Velpur Road.',href:'/experience/',link:'The Dawat experience'},
 {q:'What are Dawat’s signature dishes?',a:`Our four signatures are ${signatures.map(d=>d.name).join(', ')}. Please call for current pricing and availability of signatures not priced on the menu.`,href:'/signature-dishes/',link:'Meet the signatures'},
];
---
<BaseLayout title="FAQs | Dawat Family Restaurant, Tanuku" description="Answers to common questions about Dawat’s location, opening hours, vegetarian menu, signature dishes, dine-in service and Zomato ordering."><PageHero eyebrow="BEFORE YOUR DAWAT" title="A Few Good" italic="Questions" description="A little help before you head over." compact/><section class="container faq-layout"><aside><p class="eyebrow">STILL CURIOUS?</p><h2>Let’s talk.</h2><p>We’re happy to help during our opening hours.</p><a class="text-link" href={`tel:${restaurant.telephone}`}>{restaurant.phone}<Icon name="call"/></a></aside><div class="faq-list">{faqs.map((faq,i)=><details><summary><span class="faq-index">0{i+1}</span><h2>{faq.q}</h2><Icon name="plus"/></summary><div class="faq-answer"><p>{faq.a}</p>{faq.href&&<a class="text-link" href={faq.href}>{faq.link}<Icon/></a>}</div></details>)}</div></section><CTASection title="Now, what are you craving?"/></BaseLayout>
