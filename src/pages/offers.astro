---
import BaseLayout from '../layouts/BaseLayout.astro';import PageHero from '../components/PageHero.astro';import Picture from '../components/Picture.astro';import Icon from '../components/Icon.astro';import {restaurant} from '../data/restaurant';
---
<BaseLayout title="Offers & Specials | Dawat Family Restaurant Tanuku" description="Find out about current offers and specials at Dawat Family Restaurant. Call the restaurant or check Zomato for available promotions."><PageHero eyebrow="A LITTLE SOMETHING SPECIAL" title="Offers &" italic="Specials" description="Another reason to make it a Dawat."/><section class="container offers-content story-grid"><div class="story-image"><Picture name="butter-flux"/></div><div class="story-copy"><p class="eyebrow">WHAT’S SPECIAL TODAY?</p><h2>Good things<br/><em>are worth asking for.</em></h2><p>No offers are currently listed here. Call Dawat to ask about today’s specials, or check Zomato for any promotions available with your order.</p><div class="button-row"><a class="button" href={`tel:${restaurant.telephone}`}>Call Dawat<Icon name="call"/></a><a class="text-link" href={restaurant.zomato} target="_blank" rel="noopener noreferrer">Check Zomato<Icon/></a></div></div></section></BaseLayout>
