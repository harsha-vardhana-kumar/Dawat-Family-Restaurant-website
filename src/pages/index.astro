---
import BaseLayout from '../layouts/BaseLayout.astro';
import Picture from '../components/Picture.astro';
import Icon from '../components/Icon.astro';
import SignatureDish from '../components/SignatureDish.astro';
import MenuPreview from '../components/MenuPreview.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import LocationSection from '../components/LocationSection.astro';
import {signatures} from '../data/menu';
import {directionsUrl} from '../data/restaurant';
---
<BaseLayout title="Dawat Family Restaurant Tanuku | Biryani, Starters & Family Dining" description="Visit Dawat Family Restaurant at Rajiv Chowk, Tanuku for signature biryanis, Indian starters, curries and family dining. Open daily from 6:30 AM to 10:30 PM." dark>
<section class="home-hero"><div class="hero-photo"><Picture name="biryani" eager sizes="100vw"/></div><div class="hero-shade"></div><div class="container hero-content"><p class="eyebrow"><span class="small-rule"></span> FOOD. FAMILY. FLAVOUR.</p><h1>A Dawat Worth<br/><em>Gathering For.</em></h1><p class="hero-description">Authentic flavours, signature biryanis and memorable family dining in the heart of Tanuku.</p><div class="button-row"><a class="button button-ivory" href="/menu/">Explore Menu <Icon/></a><a class="hero-secondary" href="/order-online/">Order Online <Icon/></a></div></div><div class="hero-foot container"><p><Icon name="pin" size={16}/>Rajiv Chowk Centre · Velpur Road · Tanuku</p><a href="#signatures" class="scroll-cue">A TASTE OF WHAT’S TO COME <span>↓</span></a></div><a class="hero-seal" href="/signature-dishes/#mutton-biryani"><span>THE DAWAT</span><strong>Signature</strong><span>MUTTON DUM BIRYANI</span></a></section>
<section class="signature-section section-space" id="signatures"><div class="container"><div class="section-heading"><div><p class="eyebrow">FOUR REASONS TO GATHER</p><h2>Signatures<br/><em>of Dawat</em></h2></div><div><p>Some dishes are more than a favourite.<br/>They’re the reason you come.</p><a class="text-link" href="/signature-dishes/">Meet our signatures<Icon/></a></div></div><div class="signature-grid">{signatures.map((dish,index)=><SignatureDish dish={dish} index={index}/>)}</div></div></section>
<section class="brand-statement"><div class="container" data-reveal><span class="brand-flower" aria-hidden="true">✳</span><p class="eyebrow">THE SIMPLE JOY OF SHARING A MEAL</p><h2>Good food fills the table.<br/><em>Great food brings<br class="mobile-break"/> everyone together.</em></h2><span class="statement-rule"></span></div></section>
<MenuPreview/>
<section class="story-preview section-space"><div class="container story-grid"><div class="story-image" data-reveal><Picture name="table"/><span class="photo-caption">ROOTED IN TANUKU. MADE FOR YOUR TABLE.</span></div><div class="story-copy" data-reveal><p class="eyebrow">FAMILIAR ROOTS. A NEW GATHERING PLACE.</p><h2>From the team<br/>behind<br/><em>Star Bawarchi.</em></h2><p>Good food has a way of bringing people together. That’s the spirit behind Dawat — a family dining destination from the team behind Star Bawarchi in Tanuku.</p><p>Come for the biryani. Stay for the conversation. Make a meal of being together.</p><a class="text-link" href="/our-story/">Discover Our Story<Icon/></a></div></div></section>
<section class="family-section"><Picture name="ambience" sizes="100vw"/><div class="family-shade"></div><div class="container family-content" data-reveal><p class="eyebrow">THE BEST SEAT IS TOGETHER</p><h2>Made for Families.<br/><em>Made for Memories.</em></h2><a class="button button-ivory" href="/experience/">The Dawat Experience<Icon/></a></div><span class="ambience-disclaimer">Illustrative dining ambience</span></section>
<section class="biryani-feature"><div class="container biryani-feature-grid"><div data-reveal><p class="eyebrow">SHADI KA MUTTON DUM BIRYANI</p><h2>Dum.<br/><em>Spice.</em><br/>Patience.</h2><p>A signature worth making room for.</p><a class="text-link" href="/signature-dishes/#mutton-biryani">Discover the Dawat signature<Icon/></a></div><div class="biryani-feature-photo" data-reveal><Picture name="biryani"/><span>THE HEART OF A GOOD DAWAT</span></div></div></section>
<section class="section-space gallery-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">FEAST YOUR EYES</p><h2>A little taste<br/><em>of the good life.</em></h2></div><a class="text-link" href="/gallery/">View Gallery<Icon/></a></div><GalleryGrid preview/></div></section>
<section class="reviews-section"><div class="container reviews-inner" data-reveal><span class="review-mark" aria-hidden="true">“</span><div><p class="eyebrow">YOUR DAWAT. YOUR STORY.</p><h2>How was your<br/><em>time at our table?</em></h2><p>We’d love to hear about your visit. Find Dawat on Google Maps and share your experience.</p><a class="text-link" href={directionsUrl} target="_blank" rel="noopener noreferrer">Find Dawat & share a review<Icon/></a></div></div></section>
<LocationSection/>
</BaseLayout>
