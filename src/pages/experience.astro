---
import BaseLayout from '../layouts/BaseLayout.astro';import PageHero from '../components/PageHero.astro';import Picture from '../components/Picture.astro';import CTASection from '../components/CTASection.astro';import Icon from '../components/Icon.astro';import {restaurant} from '../data/restaurant';
---
<BaseLayout title="The Dawat Experience | Family Dining in Tanuku" description="Enjoy family dining at Dawat in Tanuku. Gather around biryanis, starters and Indian favourites, with doors open daily from 6:30 AM to 10:30 PM." dark><PageHero eyebrow="GOOD COMPANY. GREAT FLAVOURS." title="The Dawat" italic="Experience" description="Make time for a meal together." image="ambience"/><section class="container story-grid section-space"><div class="story-copy" data-reveal><p class="eyebrow">FAMILY DINING</p><h2>Pull up a chair.<br/><em>Pass the plates.</em></h2><p>Bring your family, choose a few favourites and settle into the simple pleasure of a shared meal. Dawat is a family dining spot in the heart of Tanuku.</p><a class="text-link" href="/contact/">Plan your visit<Icon/></a></div><div class="story-image" data-reveal><Picture name="table"/></div></section><section class="experience-table section-space"><div class="container"><p class="eyebrow">A TABLE FULL OF FLAVOURS</p><h2>For every person.<br/><em>For every craving.</em></h2><p>Biryanis and curries. Vegetarian favourites and chicken starters. Something to share, something to savour, and something you’ll want to come back for.</p><a class="button" href="/menu/">Explore Menu<Icon/></a></div></section><section class="container story-grid section-space"><div class="story-image" data-reveal><Picture name="chai"/></div><div class="story-copy" data-reveal><p class="eyebrow">FROM BREAKFAST TO DINNER</p><h2>A little Dawat.<br/><em>Any time of day.</em></h2><p>Our doors are open Monday to Sunday, {restaurant.hours}. Start early, stop by during the day or join us for dinner.</p><p>For breakfast options and dish availability at your preferred time, give us a call.</p><a class="text-link" href={`tel:${restaurant.telephone}`}>Call Dawat<Icon name="call"/></a></div></section><section class="gallery-moment"><Picture name="ambience" sizes="100vw"/><div><p class="eyebrow">A GLIMPSE OF THE MOOD</p><h2>A good evening<br/><em>starts at the table.</em></h2><a class="text-link" href="/gallery/">Explore the gallery<Icon/></a><p class="image-notice">Illustrative dining ambience</p></div></section><CTASection title="Make a little time for Dawat." primary="Visit Dawat" href="/contact/" text="Find us opposite Reliance Digital, Velpur Road."/></BaseLayout>
