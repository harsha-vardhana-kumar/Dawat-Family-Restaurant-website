---
import BaseLayout from '../layouts/BaseLayout.astro';import Picture from '../components/Picture.astro';import Icon from '../components/Icon.astro';import SignatureDish from '../components/SignatureDish.astro';import {signatures} from '../data/menu';import {restaurant} from '../data/restaurant';
---
<BaseLayout title="Order Dawat Online on Zomato | Tanuku" description="Order from Dawat Family Restaurant in Tanuku through Zomato, or call +91 97019 19654 for restaurant enquiries."><section class="order-hero container"><div class="order-copy"><p class="eyebrow">YOUR PLACE. OUR FLAVOURS.</p><h1>Dawat,<br/><em>Delivered.</em></h1><p>Your favourite table might be at home.<br/>Bring a little Dawat to it.</p><a class="button" href={restaurant.zomato} target="_blank" rel="noopener noreferrer">Order on Zomato<Icon/></a><a class="text-link" href={`tel:${restaurant.telephone}`}>Call Dawat<Icon name="call"/></a><p class="order-note">Check Zomato for delivery availability, current prices and order updates.</p></div><div class="order-photo"><Picture name="biryani" eager/><span class="photo-caption">GOOD FOOD. WHEREVER YOU GATHER.</span></div></section><section class="container section-space"><div class="section-heading"><div><p class="eyebrow">SOME FOOD FOR THOUGHT</p><h2>Make it<br/><em>a signature.</em></h2></div><p>Explore our signatures, then check<br/>what’s available on Zomato.</p></div><div class="signature-grid">{signatures.map((dish,index)=><SignatureDish dish={dish} index={index}/>)}</div></section></BaseLayout>
