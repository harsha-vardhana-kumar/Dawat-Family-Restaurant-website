---
import { restaurant, navigation } from '../data/restaurant';
import { photoNotice } from '../data/gallery';
import Icon from './Icon.astro';
---
<footer class="footer"><div class="container"><div class="footer-top"><div><p class="eyebrow">THERE’S ALWAYS ROOM AT OUR TABLE</p><h2>Come hungry.<br/><em>Leave happy.</em></h2></div><a class="round-link" href="/order-online/" aria-label="Order Dawat online"><Icon size={32}/></a></div><div class="footer-grid"><div><a class="wordmark" href="/"><span class="wordmark-name">dawat<span class="brand-spark">✳</span></span><span class="wordmark-sub">FAMILY RESTAURANT</span></a><p class="footer-description">Food. Family. Flavour.<br/>A Dawat worth gathering for.</p></div><div><h3>FIND YOUR DAWAT</h3><nav aria-label="Footer main navigation">{navigation.map(l=><a href={l.href}>{l.label}</a>)}</nav></div><div><h3>A LITTLE MORE</h3><nav aria-label="More pages"><a href="/experience/">The Experience</a><a href="/offers/">Offers & Specials</a><a href="/faq/">FAQs</a><a href="/order-online/">Order Online</a></nav></div><div><h3>COME ON OVER</h3><address>{restaurant.street}<br/>{restaurant.city}, {restaurant.region}<br/><span>{restaurant.landmark}</span></address><a class="footer-phone" href={`tel:${restaurant.telephone}`}>{restaurant.phone}</a><p>Open daily · {restaurant.hours}</p></div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} {restaurant.name}.</span><span>{photoNotice}</span></div></div></footer>
