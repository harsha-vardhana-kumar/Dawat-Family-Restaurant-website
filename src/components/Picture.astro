---
import { Image } from 'astro:assets';
import { photographs, type PhotoKey } from '../data/gallery';
interface Props { name: PhotoKey|string; class?: string; eager?: boolean; sizes?: string; }
const {name, class:className='', eager=false, sizes='(max-width: 700px) 100vw, 50vw'}=Astro.props;
const photo=photographs[name as PhotoKey];
---
<Image src={photo.src} alt={photo.alt} class={className} format="webp" quality={82} widths={[480,768,1200,1600]} sizes={sizes} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding="async" />
