---
import {restaurant,directionsUrl,mapEmbedUrl} from '../data/restaurant';
import Icon from './Icon.astro';
---
<section class="location-section section-space"><div class="container location-grid"><div data-reveal><p class="eyebrow">YOUR TABLE IS IN TANUKU</p><h2>Find your way<br/><em>to Dawat.</em></h2><div class="location-details"><h3>{restaurant.name}</h3><address>{restaurant.street}<br/>{restaurant.city}, {restaurant.region}</address><p class="landmark">{restaurant.landmark}</p><div class="location-hours"><span>OPEN DAILY</span><strong>{restaurant.hours}</strong></div><a class="location-phone" href={`tel:${restaurant.telephone}`}>{restaurant.phone}</a></div><div class="button-row"><a class="button" href={`tel:${restaurant.telephone}`}>Call Restaurant<Icon name="call" size={17}/></a><a class="text-link" href={directionsUrl} target="_blank" rel="noopener noreferrer">Get Directions<Icon/></a></div></div><div class="map-frame" data-reveal><iframe src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Map showing Dawat Family Restaurant, Rajiv Chowk, Tanuku" allowfullscreen></iframe><a class="map-caption" href={directionsUrl} target="_blank" rel="noopener noreferrer"><span><Icon name="pin"/>RAJIV CHOWK · VELPUR ROAD</span><Icon/></a></div></div></section>
